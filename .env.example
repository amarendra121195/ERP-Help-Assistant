# Copy this file to .env and fill in your key. .env is git-ignored.
OPENAI_API_KEY=sk-...

# Optional overrides
CHAT_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-large
REASONING_EFFORT=low
SQL_SERVER_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=arete_group;Trusted_Connection=yes;TrustServerCertificate=yes

# Evaluation only: model that checks faithfulness
JUDGE_MODEL=gpt-6-luna
